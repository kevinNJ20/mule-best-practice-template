<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- ============================================ -->
    <!-- FLOWS COMMUNS - BEST PRACTICES              -->
    <!-- ============================================ -->

    <!-- Sub-flow: Génération du Correlation ID -->
    <sub-flow name="generate-correlation-id-subflow" doc:name="Generate Correlation ID">
        <ee:transform doc:name="Set Correlation ID">
            <ee:message/>
            <ee:variables>
                <ee:set-variable variableName="correlationId"><![CDATA[%dw 2.0
import * from dw::core::Strings
output application/java
---
// Génère un UUID si pas déjà présent
if ((vars.correlationId default 'N/A') != null) 
    (vars.correlationId default 'N/A') 
else 
    uuid()]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
    </sub-flow>

    <!-- Sub-flow: Logging de début de requête -->
    <sub-flow name="log-request-start-subflow" doc:name="Log Request Start">
        <logger level="INFO" doc:name="Log Request Start" message="[START] Request received"/>
    </sub-flow>

    <!-- Sub-flow: Logging de fin de requête -->
    <sub-flow name="log-request-end-subflow" doc:name="Log Request End">
        <logger level="INFO" doc:name="Log Request End" message="[END] Request completed"/>
    </sub-flow>

    <!-- Sub-flow: Validation des données d'entrée -->
    <sub-flow name="validate-input-subflow" doc:name="Validate Input">
        <ee:transform doc:name="Validate Payload">
            <ee:message/>
            <ee:variables>
                <ee:set-variable variableName="isValidInput"><![CDATA[%dw 2.0
output application/java
---
// Exemple de validation - à adapter selon vos besoins
if (payload == null or payload == {}) 
    false 
else 
    true]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <choice doc:name="Check Validation">
            <when expression="#[vars.isValidInput == false]">
                <raise-error doc:name="Raise Validation Error" type="VALIDATION:INVALID_INPUT" 
                           description="Le payload d'entrée est invalide ou vide"/>
            </when>
        </choice>
        <logger level="DEBUG" doc:name="Log Validation Success" message="[VALIDATION] Input validation successful"/>
    </sub-flow>

    <!-- Sub-flow: Enrichissement de la réponse avec métadonnées -->
    <sub-flow name="enrich-response-subflow" doc:name="Enrich Response">
        <ee:transform doc:name="Add Response Metadata">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    data: payload,
    metadata: {
        correlationId: (vars.correlationId default 'N/A') default "",
        timestamp: now(),
        apiVersion: Mule::p('api.version'),
        environment: Mule::p('env')
    }
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </sub-flow>

    <!-- Sub-flow: Transformation des données pour service externe -->
    <sub-flow name="transform-to-external-format-subflow" doc:name="Transform To External Format">
        <logger level="DEBUG" doc:name="Log Transformation Start" message="[TRANSFORM] Transforming data for external service"/>
        <ee:transform doc:name="Transform to External Format">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
// Exemple de transformation - à adapter selon vos besoins
{
    requestId: (vars.correlationId default 'N/A'),
    data: payload,
    timestamp: now() as String { format: "yyyy-MM-dd'T'HH:mm:ss'Z'" }
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </sub-flow>

    <!-- Sub-flow: Sauvegarde du timestamp de début -->
    <sub-flow name="save-start-time-subflow" doc:name="Save Start Time">
        <set-variable variableName="startTime" value="#[now()]" doc:name="Set Start Time"/>
    </sub-flow>

</mule>

