<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- ============================================ -->
    <!-- API PROCESS LAYER - BEST PRACTICES           -->
    <!-- ============================================ -->

    <!-- Process Flow: Get Customers -->
    <flow name="process-get-customers-flow" doc:name="Process Get Customers Flow">
        <logger level="DEBUG" doc:name="Log Process Start"
                message="#['[PROCESS] CorrelationId: ' ++ vars.correlationId ++ ' | Processing get customers request']"/>
        
        <!-- Orchestration: Appel aux System APIs -->
        <flow-ref name="system-get-customers-flow" doc:name="Call System API - Get Customers"/>
        
        <!-- Enrichissement avec d'autres données si nécessaire -->
        <ee:transform doc:name="Enrich Customer Data">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
// Enrichissement des données clients avec logique métier
payload map ((customer, index) -> 
    customer ++ {
        status: if (customer.isActive == true) "ACTIVE" else "INACTIVE",
        accountAge: (now() - customer.createdAt as DateTime) as Number {unit: "days"}
    }
)]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        
        <logger level="DEBUG" doc:name="Log Process End"
                message="#['[PROCESS] CorrelationId: ' ++ vars.correlationId ++ ' | Process completed successfully | Count: ' ++ sizeOf(payload)]"/>
        
        <error-handler>
            <on-error-propagate type="ANY" enableNotifications="true" logException="true">
                <logger level="ERROR" doc:name="Log Process Error"
                        message="#['[PROCESS ERROR] CorrelationId: ' ++ vars.correlationId ++ ' | Error: ' ++ error.description]"/>
            </on-error-propagate>
        </error-handler>
    </flow>

    <!-- Process Flow: Create Customer -->
    <flow name="process-create-customer-flow" doc:name="Process Create Customer Flow">
        <logger level="DEBUG" doc:name="Log Process Start"
                message="#['[PROCESS] CorrelationId: ' ++ vars.correlationId ++ ' | Processing create customer request']"/>
        
        <!-- Validation métier -->
        <ee:transform doc:name="Business Validation">
            <ee:message/>
            <ee:variables>
                <ee:set-variable variableName="isValidEmail"><![CDATA[%dw 2.0
output application/java
---
// Validation de l'email
payload.email matches /^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Z|a-z]{2,}$/]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        
        <choice doc:name="Check Email Validation">
            <when expression="#[vars.isValidEmail == false]">
                <raise-error doc:name="Raise Invalid Email" type="VALIDATION:INVALID_EMAIL" 
                           description="L'adresse email fournie est invalide"/>
            </when>
        </choice>
        
        <!-- Transformation pour la couche System -->
        <ee:transform doc:name="Transform to System Format">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    firstName: payload.firstName,
    lastName: payload.lastName,
    emailAddress: payload.email,
    phoneNumber: payload.phone default "",
    isActive: true,
    createdAt: now(),
    createdBy: "API",
    correlationId: vars.correlationId
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        
        <!-- Appel à la couche System -->
        <flow-ref name="system-create-customer-flow" doc:name="Call System API - Create Customer"/>
        
        <logger level="DEBUG" doc:name="Log Process End"
                message="#['[PROCESS] CorrelationId: ' ++ vars.correlationId ++ ' | Customer created successfully | ID: ' ++ payload.id]"/>
        
        <error-handler>
            <on-error-propagate type="ANY" enableNotifications="true" logException="true">
                <logger level="ERROR" doc:name="Log Process Error"
                        message="#['[PROCESS ERROR] CorrelationId: ' ++ vars.correlationId ++ ' | Error: ' ++ error.description]"/>
            </on-error-propagate>
        </error-handler>
    </flow>

    <!-- Process Flow: Business Rules - Validate Transaction Amount -->
    <flow name="process-validate-transaction-amount-flow" doc:name="Process Validate Transaction Amount">
        <logger level="DEBUG" doc:name="Log Validation Start"
                message="#['[PROCESS] CorrelationId: ' ++ vars.correlationId ++ ' | Validating transaction amount']"/>
        
        <ee:transform doc:name="Validate Amount">
            <ee:message/>
            <ee:variables>
                <ee:set-variable variableName="isValidAmount"><![CDATA[%dw 2.0
output application/java
---
// Validation du montant selon les règles métier
payload.amount <= (Mule::p('business.maxTransactionAmount') as Number)]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        
        <choice doc:name="Check Amount">
            <when expression="#[vars.isValidAmount == false]">
                <raise-error doc:name="Raise Amount Exceeded" type="BUSINESS:AMOUNT_EXCEEDED"
                           description="#['Le montant ' ++ (payload.amount as String) ++ ' dépasse la limite autorisée de ' ++ Mule::p('business.maxTransactionAmount')]"/>
            </when>
        </choice>
        
        <logger level="DEBUG" doc:name="Log Validation Success"
                message="#['[PROCESS] CorrelationId: ' ++ vars.correlationId ++ ' | Transaction amount validated successfully']"/>
        
        <error-handler>
            <on-error-propagate type="ANY" enableNotifications="true" logException="true">
                <logger level="ERROR" doc:name="Log Validation Error"
                        message="#['[PROCESS ERROR] CorrelationId: ' ++ vars.correlationId ++ ' | Error: ' ++ error.description]"/>
            </on-error-propagate>
        </error-handler>
    </flow>

</mule>

