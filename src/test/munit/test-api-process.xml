<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

    <!-- ============================================ -->
    <!-- MUNIT TESTS - PROCESS LAYER                 -->
    <!-- ============================================ -->

    <!-- Test: Process Get Customers -->
    <munit:test name="test-process-get-customers-success" 
                description="Test process layer enriches customer data" 
                doc:name="Test Process Get Customers">
        <munit:behavior>
            <set-variable variableName="correlationId" value="TEST-CORR-005" doc:name="Set Test Correlation ID"/>
            
            <!-- Mock System Layer -->
            <munit-tools:mock-when doc:name="Mock System Layer" processor="flow-ref">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="system-get-customers-flow" attributeName="name"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value='#[
                    [{
                        "customerId": "CUST-001",
                        "firstName": "Jean",
                        "lastName": "Dupont",
                        "emailAddress": "jean@example.com",
                        "phoneNumber": "+33612345678",
                        "isActive": true,
                        "createdAt": "2023-01-15T10:30:00Z"
                    }]
                    ]' mediaType="application/json"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        
        <munit:execution>
            <flow-ref name="process-get-customers-flow" doc:name="Call Process Flow"/>
        </munit:execution>
        
        <munit:validation>
            <munit-tools:assert-that doc:name="Assert Status Field Added" 
                                    expression="#[payload[0].status]" 
                                    is="#[MunitTools::equalTo('ACTIVE')]"/>
            <munit-tools:assert-that doc:name="Assert Account Age Added" 
                                    expression="#[payload[0].accountAge]" 
                                    is="#[MunitTools::notNullValue()]"/>
        </munit:validation>
    </munit:test>

    <!-- Test: Process Create Customer with Valid Email -->
    <munit:test name="test-process-create-customer-valid-email" 
                description="Test process layer validates and creates customer" 
                doc:name="Test Process Create Customer Valid">
        <munit:behavior>
            <set-variable variableName="correlationId" value="TEST-CORR-006" doc:name="Set Test Correlation ID"/>
            
            <!-- Mock System Layer -->
            <munit-tools:mock-when doc:name="Mock System Layer" processor="flow-ref">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="system-create-customer-flow" attributeName="name"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value='#[{
                        "id": "123e4567-e89b-12d3-a456-426614174000",
                        "customerId": "CUST-999",
                        "firstName": "Marie",
                        "lastName": "Dubois"
                    }]' mediaType="application/json"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        
        <munit:execution>
            <munit:set-event doc:name="Set Event">
                <munit:payload value='#[{
                    "firstName": "Marie",
                    "lastName": "Dubois",
                    "email": "marie.dubois@example.com",
                    "phone": "+33698765432"
                }]' mediaType="application/json"/>
            </munit:set-event>
            
            <flow-ref name="process-create-customer-flow" doc:name="Call Process Flow"/>
        </munit:execution>
        
        <munit:validation>
            <munit-tools:assert-that doc:name="Assert Customer ID" 
                                    expression="#[payload.id]" 
                                    is="#[MunitTools::notNullValue()]"/>
        </munit:validation>
    </munit:test>

    <!-- Test: Process Create Customer with Invalid Email -->
    <munit:test name="test-process-create-customer-invalid-email" 
                description="Test process layer rejects invalid email" 
                doc:name="Test Process Create Customer Invalid Email"
                expectedErrorType="VALIDATION:INVALID_EMAIL">
        <munit:behavior>
            <set-variable variableName="correlationId" value="TEST-CORR-007" doc:name="Set Test Correlation ID"/>
        </munit:behavior>
        
        <munit:execution>
            <munit:set-event doc:name="Set Event with Invalid Email">
                <munit:payload value='#[{
                    "firstName": "Test",
                    "lastName": "User",
                    "email": "invalid-email",
                    "phone": "+33612345678"
                }]' mediaType="application/json"/>
            </munit:set-event>
            
            <flow-ref name="process-create-customer-flow" doc:name="Call Process Flow"/>
        </munit:execution>
    </munit:test>

    <!-- Test: Validate Transaction Amount - Valid -->
    <munit:test name="test-validate-transaction-amount-valid" 
                description="Test transaction amount validation passes for valid amount" 
                doc:name="Test Validate Amount Valid">
        <munit:behavior>
            <set-variable variableName="correlationId" value="TEST-CORR-008" doc:name="Set Test Correlation ID"/>
        </munit:behavior>
        
        <munit:execution>
            <munit:set-event doc:name="Set Event">
                <munit:payload value='#[{"amount": 5000}]' mediaType="application/json"/>
            </munit:set-event>
            
            <flow-ref name="process-validate-transaction-amount-flow" doc:name="Call Validation Flow"/>
        </munit:execution>
        
        <munit:validation>
            <munit-tools:assert-that doc:name="Assert Amount" 
                                    expression="#[payload.amount]" 
                                    is="#[MunitTools::equalTo(5000)]"/>
        </munit:validation>
    </munit:test>

    <!-- Test: Validate Transaction Amount - Exceeded -->
    <munit:test name="test-validate-transaction-amount-exceeded" 
                description="Test transaction amount validation fails for exceeded amount" 
                doc:name="Test Validate Amount Exceeded"
                expectedErrorType="BUSINESS:AMOUNT_EXCEEDED">
        <munit:behavior>
            <set-variable variableName="correlationId" value="TEST-CORR-009" doc:name="Set Test Correlation ID"/>
        </munit:behavior>
        
        <munit:execution>
            <munit:set-event doc:name="Set Event with Large Amount">
                <munit:payload value='#[{"amount": 999999}]' mediaType="application/json"/>
            </munit:set-event>
            
            <flow-ref name="process-validate-transaction-amount-flow" doc:name="Call Validation Flow"/>
        </munit:execution>
    </munit:test>

</mule>

