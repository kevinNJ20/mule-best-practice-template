<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" 
      xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" 
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd 
        http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
    
    <!-- ============================================ -->
    <!-- CONFIGURATION GLOBALE - BEST PRACTICES       -->
    <!-- ============================================ -->
    
    <!-- Chargement du fichier de configuration pour LOCAL -->
    <!-- Pour changer d'environnement, modifier le nom du fichier : config.local.yaml, config.dev.yaml, config.prod.yaml -->
    <configuration-properties doc:name="Configuration Properties" file="config.local.yaml"/>
    
    <!-- ============================================ -->
    <!-- APIKIT CONFIGURATION                         -->
    <!-- ============================================ -->
    
    <!-- APIKit Configuration -->
    <apikit:config name="apikit-config" 
                   api="api/mule-best-practice-template.raml" 
                   outboundHeadersMapName="outboundHeaders" 
                   httpStatusVarName="httpStatus"
                   doc:name="APIkit Config"/>
    
    <!-- ============================================ -->
    <!-- HTTP CONFIGURATIONS                          -->
    <!-- ============================================ -->
    
    <!-- HTTP Listener Configuration - API Inbound -->
    <http:listener-config doc:name="HTTP Listener Config" name="HTTP_Listener_config">
        <http:listener-connection host="${http.host}" port="${http.port}"/>
    </http:listener-config>
    
    <!-- HTTP Request Configuration - External Services -->
    <http:request-config name="HTTP_Request_External_Config" doc:name="HTTP Request Configuration"/>
    
</mule>
