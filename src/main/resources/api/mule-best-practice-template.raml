#%RAML 1.0
title: Mule Best Practice Template API
version: v1
baseUri: https://{environment}/api
protocols: [ HTTP, HTTPS ]
mediaType: application/json

baseUriParameters:
  environment:
    description: L'environnement de l'API
    type: string
    example: localhost:8082
    default: mule-best-practice-template-2appqr.9d3fd9-2.can-c1.cloudhub.io

documentation:
  - title: Introduction
    content: |
      Template de référence MuleSoft implémentant toutes les best practices pour le développement d'applications Mule.
      
      Cette API démontre :
      - Architecture API-led Connectivity (Experience, Process, System)
      - Gestion globale des erreurs
      - Logging standardisé avec Correlation ID
      - Validation des données
      - Patterns MuleSoft courants
      
  - title: Authentification
    content: |
      Cette API de démonstration ne requiert pas d'authentification.
      En production, utilisez OAuth 2.0, JWT ou Client ID Enforcement.
      
  - title: Traçabilité
    content: |
      Toutes les réponses incluent un header X-Correlation-ID pour la traçabilité complète.

types:
  Customer:
    type: object
    properties:
      id:
        type: string
        example: "CUST-001"
      fullName:
        type: string
        example: "Jean Dupont"
      email:
        type: string
        pattern: ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Z|a-z]{2,}$
        example: "jean.dupont@example.com"
      phone:
        type: string
        example: "+33612345678"
      registrationDate:
        type: datetime
        example: "2023-01-15T10:30:00Z"
        
  CustomerInput:
    type: object
    properties:
      firstName:
        type: string
        required: true
        minLength: 2
        maxLength: 50
        example: "Marie"
      lastName:
        type: string
        required: true
        minLength: 2
        maxLength: 50
        example: "Dupont"
      email:
        type: string
        required: true
        pattern: ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Z|a-z]{2,}$
        example: "marie.dupont@example.com"
      phone:
        type: string
        example: "+33612345678"
        
  CustomerResponse:
    type: object
    properties:
      customers:
        type: Customer[]
      totalCount:
        type: integer
        example: 3
      correlationId:
        type: string
        example: "abc-123-def-456"
      timestamp:
        type: datetime
        
  CreateCustomerResponse:
    type: object
    properties:
      message:
        type: string
        example: "Client créé avec succès"
      customerId:
        type: string
        example: "CUST-999"
      correlationId:
        type: string
      timestamp:
        type: datetime
        
  HealthCheckResponse:
    type: object
    properties:
      status:
        type: string
        enum: [UP, DOWN]
        example: "UP"
      timestamp:
        type: datetime
      application:
        type: object
        properties:
          name:
            type: string
            example: "Mule Best Practice API"
          version:
            type: string
            example: "v1"
          environment:
            type: string
            enum: [local, dev, prod]
            example: "local"
      correlationId:
        type: string
        
  TransactionMessage:
    type: object
    properties:
      type:
        type: string
        enum: [PAYMENT, REFUND, TRANSFER]
        required: true
        example: "PAYMENT"
      amount:
        type: number
        required: true
        minimum: 0
        example: 150.50
      currency:
        type: string
        pattern: ^[A-Z]{3}$
        example: "EUR"
        
  IdempotentMessage:
    type: object
    properties:
      messageId:
        type: string
        required: true
        example: "MSG-001"
      data:
        type: any
        
  BatchRequest:
    type: object
    properties:
      items:
        type: array
        items:
          type: object
        minItems: 1
        example: [{"id": 1, "value": "test"}, {"id": 2, "value": "test2"}]
        
  ErrorResponse:
    type: object
    properties:
      error:
        type: object
        properties:
          code:
            type: string
            example: "BAD_REQUEST"
          message:
            type: string
            example: "La requête est invalide"
          details:
            type: string
          timestamp:
            type: datetime
          correlationId:
            type: string

traits:
  correlationId:
    headers:
      X-Correlation-ID:
        type: string
        required: false
        description: ID de corrélation pour la traçabilité
    responses:
      200:
        headers:
          X-Correlation-ID:
            type: string
            description: ID de corrélation retourné
      201:
        headers:
          X-Correlation-ID:
            type: string
            
  errorResponses:
    responses:
      400:
        body:
          application/json:
            type: ErrorResponse
            example: |
              {
                "error": {
                  "code": "BAD_REQUEST",
                  "message": "La requête est invalide",
                  "details": "Le payload d'entrée est invalide ou vide",
                  "timestamp": "2024-11-07T14:30:00Z",
                  "correlationId": "abc-123"
                }
              }
      404:
        body:
          application/json:
            type: ErrorResponse
      500:
        body:
          application/json:
            type: ErrorResponse

/health:
  displayName: Health Check
  description: Vérifie l'état de santé de l'application
  get:
    is: [correlationId, errorResponses]
    description: Retourne l'état de l'application et ses métadonnées
    responses:
      200:
        body:
          application/json:
            type: HealthCheckResponse
            example: |
              {
                "status": "UP",
                "timestamp": "2024-11-07T14:30:00Z",
                "application": {
                  "name": "Mule Best Practice API",
                  "version": "v1",
                  "environment": "local"
                },
                "correlationId": "abc-123"
              }

/customers:
  displayName: Customers
  description: Gestion des clients
  get:
    is: [correlationId, errorResponses]
    description: Récupère la liste de tous les clients
    responses:
      200:
        body:
          application/json:
            type: CustomerResponse
            example: |
              {
                "customers": [
                  {
                    "id": "CUST-001",
                    "fullName": "Jean Dupont",
                    "email": "jean.dupont@example.com",
                    "phone": "+33612345678",
                    "registrationDate": "2023-01-15T10:30:00Z"
                  }
                ],
                "totalCount": 1,
                "correlationId": "abc-123",
                "timestamp": "2024-11-07T14:30:00Z"
              }
              
  post:
    is: [correlationId, errorResponses]
    description: Crée un nouveau client
    body:
      application/json:
        type: CustomerInput
        example: |
          {
            "firstName": "Marie",
            "lastName": "Dupont",
            "email": "marie.dupont@example.com",
            "phone": "+33612345678"
          }
    responses:
      201:
        headers:
          Location:
            type: string
            example: "/api/v1/customers/CUST-999"
          X-Correlation-ID:
            type: string
        body:
          application/json:
            type: CreateCustomerResponse
            example: |
              {
                "message": "Client créé avec succès",
                "customerId": "CUST-999",
                "correlationId": "abc-123",
                "timestamp": "2024-11-07T14:30:00Z"
              }

/patterns:
  displayName: Patterns MuleSoft
  description: Exemples de patterns d'intégration MuleSoft
  
  /scatter-gather:
    displayName: Scatter-Gather Pattern
    description: Appelle plusieurs services en parallèle et agrège les résultats
    get:
      is: [correlationId, errorResponses]
      description: Démontre le pattern Scatter-Gather en récupérant des données de plusieurs sources
      responses:
        200:
          body:
            application/json:
              example: |
                {
                  "customer": {
                    "customerId": "CUST-001",
                    "name": "Jean Dupont",
                    "tier": "GOLD"
                  },
                  "orders": [
                    {"orderId": "ORD-001", "amount": 150.50}
                  ],
                  "loyalty": {
                    "points": 1250,
                    "tier": "GOLD"
                  },
                  "correlationId": "abc-123",
                  "timestamp": "2024-11-07T14:30:00Z"
                }
                
  /route-message:
    displayName: Content-Based Routing
    description: Route les messages selon leur contenu (type de transaction)
    post:
      is: [correlationId, errorResponses]
      description: Démontre le routage basé sur le contenu (PAYMENT, REFUND, TRANSFER)
      body:
        application/json:
          type: TransactionMessage
          example: |
            {
              "type": "PAYMENT",
              "amount": 150.50,
              "currency": "EUR"
            }
      responses:
        200:
          body:
            application/json:
              example: |
                {
                  "status": "PAYMENT_PROCESSED",
                  "transactionId": "123e4567-e89b-12d3-a456-426614174000",
                  "amount": 150.50,
                  "message": "Paiement traité avec succès",
                  "correlationId": "abc-123"
                }
                
  /idempotent:
    displayName: Idempotent Filter
    description: Évite le traitement en double des messages
    post:
      is: [correlationId, errorResponses]
      description: Démontre le pattern Idempotent - un message avec le même ID ne sera traité qu'une fois
      body:
        application/json:
          type: IdempotentMessage
          example: |
            {
              "messageId": "MSG-001",
              "data": "test data"
            }
      responses:
        200:
          body:
            application/json:
              example: |
                {
                  "status": "PROCESSED",
                  "message": "Message traité avec succès",
                  "messageId": "MSG-001",
                  "correlationId": "abc-123",
                  "timestamp": "2024-11-07T14:30:00Z"
                }
                
  /batch:
    displayName: Batch Processing
    description: Traite les données par lots pour optimiser les performances
    post:
      is: [correlationId, errorResponses]
      description: Démontre le traitement par lots - divise les données en groupes configurables
      body:
        application/json:
          type: BatchRequest
          example: |
            {
              "items": [
                {"id": 1, "value": "item1"},
                {"id": 2, "value": "item2"},
                {"id": 3, "value": "item3"}
              ]
            }
      responses:
        200:
          body:
            application/json:
              example: |
                {
                  "status": "BATCH_COMPLETED",
                  "totalItemsProcessed": 3,
                  "correlationId": "abc-123",
                  "completedAt": "2024-11-07T14:30:00Z"
                }
